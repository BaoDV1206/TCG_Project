# Copy file này thành .env rồi sửa giá trị:  cp .env.example .env
# KHÔNG đưa file .env lên git.

# Địa chỉ web công khai (dùng cho CORS)
PUBLIC_URL=https://tcg.baodv3.io.vn

# Cổng web trên máy chủ. Cloudflare Tunnel trỏ tới http://localhost:8088
WEB_PORT=8088
# 127.0.0.1 = chỉ máy local truy cập được (an toàn, dùng khi cloudflared cài trực tiếp trên Ubuntu)
# 0.0.0.0   = mở cho cả mạng LAN / cloudflared chạy trong docker khác
WEB_BIND=127.0.0.1

# Mật khẩu database (tự đặt, chuỗi dài ngẫu nhiên)
DB_PASSWORD=doi-mat-khau-db-nay

# Khóa ký JWT, tối thiểu 32 ký tự. Tạo nhanh: openssl rand -base64 48
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu

# Tài khoản admin được tạo lần đầu khởi động
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-admin-nay

# Đăng nhập bằng Google (xem DEPLOY.md mục 7). Để trống = ẩn nút Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# RAM cho Java (mini PC 4GB RAM: 512m là đủ)
JAVA_OPTS=-Xms128m -Xmx512m
